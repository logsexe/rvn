// Shared row types passed from Rust into the surfaces.

export struct WaypointRow {
    name: string,
    coords: string,
    marked: string,
}

export struct MeshLine {
    time: string,
    who: string,
    body: string,
    outbound: bool,
}

export struct MeshNode {
    id: string,
    role: string,
    own: bool,
}

export struct LinkRow {
    text: string,
}

export struct ScanHit {
    freq: string,
    level: float,
}

export struct BandChoice {
    id: string,
    label: string,
}

export struct BandNote {
    range: string,
    name: string,
    purpose: string,
}

import { Theme } from "theme.slint";
import { StatusDot } from "components.slint";
import { WaypointRow } from "models.slint";

// NAV — a map you can move around, with the fix beside it

component FixBadge inherits Rectangle {
    in property <string> fix: "NO FIX";
    in property <string> readiness: "offline";

    height: 28px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: readiness == "ok" || readiness == "active" ? Theme.accent-dim :
                  readiness == "warn" ? Theme.warn : Theme.border;
    background: readiness == "ok" || readiness == "active" ? Theme.accent-muted :
                Theme.bg-panel;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        StatusDot { state: readiness; }

        Text {
            text: fix;
            font-size: 11px;
            font-weight: 700;
            color: readiness == "ok" || readiness == "active" ? Theme.accent :
                   readiness == "warn" ? Theme.warn : Theme.text-muted;
            font-family: Theme.font-mono;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
}

component MiniMetric inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-panel;
    horizontal-stretch: 1;
    min-height: 48px;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        alignment: center;

        Text {
            text: label;
            font-size: 10px;
            font-weight: 700;
            color: Theme.text-faint;
            font-family: Theme.font-mono;
            letter-spacing: 1px;
        }
        Text {
            text: value;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
            overflow: elide;
        }
    }
}

component WaypointLine inherits Rectangle {
    in property <string> name: "";
    in property <string> coords: "";
    in property <string> marked: "";

    height: 36px;

    VerticalLayout {
        alignment: center;
        spacing: 1px;

        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: center;

            Text {
                text: name;
                font-size: 11px;
                font-weight: 700;
                color: Theme.accent;
                font-family: Theme.font-mono;
                min-width: 52px;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: marked;
                font-size: 10px;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
            }
        }

        Text {
            text: coords;
            font-size: 12px;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
        }
    }
}

component Metric inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";

    spacing: Theme.space-8;
    height: 20px;

    Text {
        text: label;
        font-size: 11px;
        color: Theme.text-faint;
        font-family: Theme.font-mono;
        min-width: 52px;
        vertical-alignment: center;
    }
    Text {
        text: value;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        horizontal-stretch: 1;
        overflow: elide;
        vertical-alignment: center;
    }
}

component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> emphasis: false;
    callback clicked;

    height: 32px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: emphasis && enabled ? Theme.accent-dim : (enabled ? Theme.border-strong : Theme.border);
    background: emphasis && enabled ? Theme.accent-muted : Theme.bg-panel;
    opacity: enabled ? 1.0 : 0.45;

    Text {
        width: 100%; height: 100%;
        text: label;
        font-size: 11px;
        font-weight: 600;
        color: emphasis && enabled ? Theme.accent : (enabled ? Theme.text-secondary : Theme.text-faint);
        font-family: Theme.font-mono;
        letter-spacing: 0.6px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    states [
        hover when ta.has-hover && enabled: {
            border-color: Theme.border-accent;
            background: Theme.bg-hover;
        }
    ]

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: enabled ? pointer : default;
    }
}

component MapButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> on: false;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: on ? Theme.accent-dim : Theme.border-strong;
    background: on ? Theme.accent-muted : Theme.bg-panel;

    Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: 14px;
        font-weight: 700;
        color: on ? Theme.accent : Theme.text-primary;
        font-family: Theme.font-mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component HomeButton inherits Rectangle {
    callback clicked;

    width: 96px;
    height: 30px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-panel;

    Text {
        width: 100%; height: 100%;
        text: "Esc  home";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        font-family: Theme.font-sans;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component NavSurface inherits Rectangle {
    in property <string> device: "";
    in property <string> readiness: "offline";
    in property <string> fix: "NO FIX";
    in property <int> sats: 0;
    in property <string> lat: "—";
    in property <string> lon: "—";
    in property <string> alt: "—";
    in property <string> speed: "—";
    in property <string> heading: "—";
    in property <string> grid-ref: "—";
    in property <string> accuracy: "—";
    in property <string> last-update: "—";
    in property <bool> tracking: false;
    in property <int> track-count: 0;
    in property <string> notice: "";
    in property <[WaypointRow]> waypoints;
    in property <image> map-image;
    in property <string> map-caption: "";
    in property <bool> map-following: true;

    callback close;
    callback mark-waypoint;
    callback toggle-track;
    callback copy-coords;
    callback map-pan(float, float);
    callback map-zoom(int);
    callback map-recenter();
    callback map-resized(float, float);

    property <bool> drag-on: false;
    property <length> drag-x: 0px;
    property <length> drag-y: 0px;

    background: Theme.bg-void;

    VerticalLayout {
        padding: Theme.space-12;
        spacing: Theme.space-12;

        HorizontalLayout {
            spacing: Theme.space-12;
            alignment: center;

            Text {
                text: "NAV";
                font-size: 22px;
                font-weight: 600;
                color: Theme.text-primary;
                font-family: Theme.font-sans;
            }

            Text {
                text: "// MAP";
                font-size: 12px;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            FixBadge {
                fix: fix;
                readiness: readiness;
            }

            HomeButton { clicked => { root.close(); } }
        }

        HorizontalLayout {
            spacing: Theme.space-12;
            vertical-stretch: 1;

            map-frame := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-width: 0px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                background: #0c1218;
                clip: true;

                changed width => { root.map-resized(self.width / 1px, self.height / 1px); }
                changed height => { root.map-resized(self.width / 1px, self.height / 1px); }

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.map-image;
                    image-fit: fill;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;

                    moved => {
                        if (self.pressed) {
                            if (!root.drag-on) {
                                root.drag-on = true;
                                root.drag-x = self.pressed-x;
                                root.drag-y = self.pressed-y;
                            }
                            root.map-pan((self.mouse-x - root.drag-x) / 1px, (self.mouse-y - root.drag-y) / 1px);
                            root.drag-x = self.mouse-x;
                            root.drag-y = self.mouse-y;
                        } else {
                            root.drag-on = false;
                        }
                    }
                    scroll-event(event) => {
                        if (event.delta-y < 0) {
                            root.map-zoom(1);
                        } else if (event.delta-y > 0) {
                            root.map-zoom(-1);
                        }
                        return accept;
                    }
                    double-clicked => { root.map-zoom(1); }
                }

                Rectangle {
                    x: 10px;
                    y: parent.height - 36px;
                    width: parent.width - 20px;
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: #080a0ecc;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: map-caption;
                            font-size: 11px;
                            color: Theme.text-secondary;
                            font-family: Theme.font-sans;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    x: parent.width - 48px;
                    y: 12px;
                    width: 36px;
                    height: 120px;
                    spacing: 6px;

                    MapButton { label: "+"; clicked => { root.map-zoom(1); } }
                    MapButton { label: "−"; clicked => { root.map-zoom(-1); } }
                    MapButton {
                        label: "⌖";
                        on: map-following;
                        clicked => { root.map-recenter(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                min-width: 0px;

                if device != "": Text {
                    text: device;
                    font-size: 12px;
                    color: Theme.accent-dim;
                    font-family: Theme.font-sans;
                    wrap: word-wrap;
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg-panel;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Metric { label: "LAT"; value: lat; }
                        Metric { label: "LON"; value: lon; }
                        Metric { label: "GRID"; value: grid-ref; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    MiniMetric { label: "ALT"; value: alt; }
                    MiniMetric { label: "SPD"; value: speed; }
                    MiniMetric { label: "HDG"; value: heading; }
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg-panel;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Metric { label: "SATS"; value: "" + sats; }
                        Metric { label: "ACC"; value: accuracy; }
                        Metric { label: "AGE"; value: last-update; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    ActionButton {
                        label: "MARK";
                        enabled: readiness == "ok" || readiness == "active";
                        clicked => { root.mark-waypoint(); }
                    }
                    ActionButton {
                        label: tracking ? "STOP" : "TRACK";
                        enabled: tracking || readiness == "ok" || readiness == "active";
                        clicked => { root.toggle-track(); }
                    }
                    ActionButton {
                        label: "COPY";
                        enabled: lat != "—";
                        clicked => { root.copy-coords(); }
                    }
                }

                Text {
                    text: notice != "" ? notice : (tracking ? "TRACKING · " + track-count + " PTS" : "Drag the map. Marks and the track draw on it.");
                    font-size: 11px;
                    color: notice != "" || tracking ? Theme.accent : Theme.text-faint;
                    font-family: Theme.font-sans;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg-panel;

                    if waypoints.length == 0: Text {
                        width: 100%;
                        height: 100%;
                        text: "NO WAYPOINTS";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-faint;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if waypoints.length > 0: Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: self.width;
                        content-height: wp-list.preferred-height;

                        wp-list := VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            for wp in waypoints: WaypointLine {
                                name: wp.name;
                                coords: wp.coords;
                                marked: wp.marked;
                            }
                        }
                    }
                }
            }
        }
    }
}

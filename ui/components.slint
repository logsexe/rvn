import { Theme } from "theme.slint";

// ----------------------------------------------------------
// StatusDot
// ----------------------------------------------------------

component DataPill inherits HorizontalLayout {
    in property <string> key: "";
    in property <string> val: "";

    spacing: 5px;
    alignment: center;

    Text {
        text: key;
        font-size: 10px;
        font-weight: 600;
        color: Theme.text-faint;
        font-family: Theme.font-mono;
        letter-spacing: 0.5px;
    }

    Text {
        text: val;
        font-size: 12px;
        color: Theme.text-secondary;
        font-family: Theme.font-mono;
    }
}

component RectDivider inherits Rectangle {
    width: 1px;
    height: 16px;
    background: Theme.border;
}

// ----------------------------------------------------------
// TopBar
// ----------------------------------------------------------
export component StatusDot inherits Rectangle {
    in property <string> state: "offline";

    width: 9px;
    height: 9px;
    border-radius: 5px;

    background: state == "ok" ? Theme.status-ok :
                state == "warn" ? Theme.status-warn :
                state == "error" ? Theme.status-error :
                state == "active" ? Theme.status-active :
                Theme.status-offline;

    animate background { duration: 300ms; }
}

// ----------------------------------------------------------
// SurfaceTile — home grid
// ----------------------------------------------------------
export component SurfaceTile inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> glyph: "";
    in property <string> status: "offline";
    in property <bool> selected: false;
    callback clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 0px;
    min-height: 0px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: selected ? Theme.border-accent : Theme.border;
    background: selected ? Theme.bg-elevated : Theme.bg-panel;
    clip: true;

    animate border-color, background {
        duration: 160ms;
        easing: ease-out;
    }

    states [
        hover when ta.has-hover && !selected: {
            background: Theme.bg-hover;
            border-color: Theme.border-strong;
            bar.background: Theme.accent;
        }
    ]

    bar := Rectangle {
        y: 0;
        height: 2px;
        width: 100%;
        background: selected ? Theme.accent : Theme.border;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        padding: 16px;
        padding-top: 18px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-12;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    width: 100%;
                    height: 100%;
                    text: glyph;
                    font-size: 18px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            StatusDot { state: status; }
        }

        VerticalLayout {
            spacing: 4px;

            Text {
                text: title;
                font-size: 20px;
                font-weight: 600;
                color: Theme.text-primary;
                font-family: Theme.font-sans;
                letter-spacing: 0.2px;
            }

            Text {
                text: subtitle;
                font-size: 13px;
                color: Theme.text-muted;
                font-family: Theme.font-sans;
            }
        }
    }
}

export component TopBar inherits Rectangle {
    in property <string> time-str: "00:00:00";
    in property <string> op-name: "STANDBY";
    in property <string> gps-status: "NO FIX";
    in property <string> mesh-status: "OFFLINE";
    in property <string> power-str: "—";

    height: 48px;
    background: Theme.bg-base;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: 100%;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: Theme.accent;
        }

        Text {
            text: "RVN";
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-primary;
            font-family: Theme.font-sans;
            letter-spacing: 1.2px;
        }

        RectDivider { }

        Text {
            text: op-name;
            font-size: 12px;
            color: Theme.text-secondary;
            font-family: Theme.font-sans;
            letter-spacing: 0.4px;
        }

        Rectangle { horizontal-stretch: 1; }

        HorizontalLayout {
            spacing: Theme.space-12;
            alignment: center;

            DataPill { key: "GPS"; val: gps-status; }
            DataPill { key: "MESH"; val: mesh-status; }
            DataPill { key: "PWR"; val: power-str; }
        }

        RectDivider { }

        Text {
            text: time-str;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
        }
    }
}


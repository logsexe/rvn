import { Theme } from "theme.slint";
import { SurfaceTile, TopBar } from "components.slint";
import { SystemSurface } from "system.slint";
import { NavSurface } from "nav.slint";
import { RadioSurface } from "radio.slint";
import { MeshSurface } from "mesh.slint";
import { TerminalSurface } from "terminal.slint";

export component AppWindow inherits Window {
    title: "RVN";
    width: 1280px;
    height: 800px;
    background: Theme.bg-void;
    default-font-family: Theme.font-sans;

    in-out property <int> active-surface: -1;

    // Top bar
    in-out property <string> current-time: "00:00:00";
    in-out property <string> op-name: "STANDBY";
    in-out property <string> gps-status: "NO FIX";
    in-out property <string> mesh-status: "OFFLINE";
    in-out property <string> power-str: "—";

    // Card status
    in-out property <string> nav-status: "offline";
    in-out property <string> radio-status: "offline";
    in-out property <string> mesh-card-status: "offline";
    in-out property <string> terminal-status: "ok";
    in-out property <string> system-status: "ok";

    // SYSTEM
    in-out property <string> sys-cpu-model: "Raspberry Pi 5";
    in-out property <float> sys-cpu-percent: 0;
    in-out property <float> sys-temp-c: 0;
    in-out property <int> sys-mem-used: 0;
    in-out property <int> sys-mem-total: 8192;
    in-out property <string> sys-power-source: "Unknown";
    in-out property <string> sys-power-percent: "—";
    in-out property <string> sys-power-voltage: "—";
    in-out property <bool> sys-throttled: false;
    in-out property <string> sys-gps-readiness: "offline";
    in-out property <string> sys-gps-fix: "NO FIX";
    in-out property <int> sys-gps-sats: 0;
    in-out property <string> sys-gps-lat: "—";
    in-out property <string> sys-gps-lon: "—";
    in-out property <string> sys-radio-readiness: "offline";
    in-out property <string> sys-radio-device: "—";
    in-out property <string> sys-radio-freq: "—";
    in-out property <string> sys-mesh-readiness: "offline";
    in-out property <string> sys-mesh-node: "—";
    in-out property <int> sys-mesh-nodes: 0;
    in-out property <float> sys-storage-used: 0;
    in-out property <string> sys-storage-free: "—";
    in-out property <string> sys-net-ifaces: "—";

    // NAV
    in-out property <string> nav-readiness: "offline";
    in-out property <string> nav-fix: "NO FIX";
    in-out property <int> nav-sats: 0;
    in-out property <string> nav-lat: "—";
    in-out property <string> nav-lon: "—";
    in-out property <string> nav-alt: "—";
    in-out property <string> nav-speed: "—";
    in-out property <string> nav-heading: "—";
    in-out property <string> nav-grid: "—";
    in-out property <string> nav-accuracy: "—";
    in-out property <string> nav-age: "—";

    // RADIO
    in-out property <string> radio-readiness: "offline";
    in-out property <string> radio-device: "—";
    in-out property <string> radio-freq: "—";
    in-out property <string> radio-rate: "—";
    in-out property <bool> radio-streaming: false;

    // MESH
    in-out property <string> mesh-readiness: "offline";
    in-out property <string> mesh-node-id: "—";
    in-out property <int> mesh-nodes-heard: 0;
    in-out property <string> mesh-last-rx: "—";
    in-out property <string> mesh-region: "AU915";
    in-out property <bool> mesh-tx-enabled: false;
    in-out property <string> mesh-draft: "";

    // TERMINAL
    in-out property <string> term-output: "";
    in-out property <string> term-input: "";
    in-out property <string> term-cwd: "~";
    in-out property <bool> term-busy: false;

    callback surface-selected(int);
    callback go-home();
    callback radio-tune-up();
    callback radio-tune-down();
    callback radio-toggle-stream();
    callback mesh-toggle-tx();
    callback mesh-send();
    callback term-submit(string);
    callback term-clear();

    VerticalLayout {
        spacing: 0;

        TopBar {
            time-str: current-time;
            op-name: op-name;
            gps-status: gps-status;
            mesh-status: mesh-status;
            power-str: power-str;
        }

        Rectangle {
            background: Theme.bg-void;
            vertical-stretch: 1;

            if active-surface == -1: Rectangle {
                VerticalLayout {
                    padding: Theme.space-24;
                    spacing: Theme.space-20;

                    HorizontalLayout {
                        spacing: Theme.space-12;
                        alignment: center;
                        Text {
                            text: "FIELD//OS";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-faint;
                            font-family: Theme.font-mono;
                            letter-spacing: 3px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "5 SURFACES";
                            font-size: 11px;
                            color: Theme.text-faint;
                            font-family: Theme.font-mono;
                            letter-spacing: 1px;
                        }
                    }

                    GridLayout {
                        spacing: Theme.space-12;
                        vertical-stretch: 1;

                        SurfaceTile {
                            row: 0; col: 0;
                            title: "NAV";
                            subtitle: "Position · Tracks";
                            glyph: "⌖";
                            status: nav-status;
                            clicked => { active-surface = 0; surface-selected(0); }
                        }
                        SurfaceTile {
                            row: 0; col: 1;
                            title: "RADIO";
                            subtitle: "Spectrum · Receive";
                            glyph: "◈";
                            status: radio-status;
                            clicked => { active-surface = 1; surface-selected(1); }
                        }
                        SurfaceTile {
                            row: 0; col: 2;
                            title: "MESH";
                            subtitle: "Nodes · Messages";
                            glyph: "⬡";
                            status: mesh-card-status;
                            clicked => { active-surface = 2; surface-selected(2); }
                        }
                        SurfaceTile {
                            row: 1; col: 0;
                            title: "TERMINAL";
                            subtitle: "Operator Shell";
                            glyph: ">_";
                            status: terminal-status;
                            clicked => { active-surface = 3; surface-selected(3); }
                        }
                        SurfaceTile {
                            row: 1; col: 1;
                            title: "SYSTEM";
                            subtitle: "Health · Modules";
                            glyph: "▣";
                            status: system-status;
                            clicked => { active-surface = 4; surface-selected(4); }
                        }
                        Rectangle { row: 1; col: 2; background: transparent; }
                    }
                }
            }

            if active-surface == 0: NavSurface {
                readiness: nav-readiness;
                fix: nav-fix;
                sats: nav-sats;
                lat: nav-lat;
                lon: nav-lon;
                alt: nav-alt;
                speed: nav-speed;
                heading: nav-heading;
                grid-ref: nav-grid;
                accuracy: nav-accuracy;
                last-update: nav-age;
                close => { active-surface = -1; go-home(); }
            }

            if active-surface == 1: RadioSurface {
                readiness: radio-readiness;
                device: radio-device;
                freq: radio-freq;
                sample-rate: radio-rate;
                streaming: radio-streaming;
                close => { active-surface = -1; go-home(); }
                tune-up => { radio-tune-up(); }
                tune-down => { radio-tune-down(); }
                toggle-stream => { radio-toggle-stream(); }
            }

            if active-surface == 2: MeshSurface {
                readiness: mesh-readiness;
                node-id: mesh-node-id;
                nodes-heard: mesh-nodes-heard;
                last-rx: mesh-last-rx;
                region: mesh-region;
                tx-enabled: mesh-tx-enabled;
                draft <=> mesh-draft;
                close => { active-surface = -1; go-home(); }
                toggle-tx => { mesh-toggle-tx(); }
                send-message => { mesh-send(); }
            }

            if active-surface == 3: TerminalSurface {
                output <=> term-output;
                input <=> term-input;
                cwd: term-cwd;
                busy: term-busy;
                close => { active-surface = -1; go-home(); }
                submit(cmd) => { term-submit(cmd); }
                clear-output => { term-clear(); }
            }

            if active-surface == 4: SystemSurface {
                cpu-model: sys-cpu-model;
                cpu-percent: sys-cpu-percent;
                temp-c: sys-temp-c;
                mem-used-mb: sys-mem-used;
                mem-total-mb: sys-mem-total;
                power-source: sys-power-source;
                power-percent: sys-power-percent;
                power-voltage: sys-power-voltage;
                throttled: sys-throttled;
                gps-readiness: sys-gps-readiness;
                gps-fix: sys-gps-fix;
                gps-sats: sys-gps-sats;
                gps-lat: sys-gps-lat;
                gps-lon: sys-gps-lon;
                radio-readiness: sys-radio-readiness;
                radio-device: sys-radio-device;
                radio-freq: sys-radio-freq;
                mesh-readiness: sys-mesh-readiness;
                mesh-node: sys-mesh-node;
                mesh-nodes: sys-mesh-nodes;
                storage-used: sys-storage-used;
                storage-free: sys-storage-free;
                net-ifaces: sys-net-ifaces;
                close => { active-surface = -1; go-home(); }
            }
        }
    }

    focusable: true;
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            active-surface = -1;
            go-home();
            return accept;
        }
        return reject;
    }
}

component PlaceholderSurface inherits Rectangle {
    in property <string> name: "";
    callback close;
    background: Theme.bg-void;

    VerticalLayout {
        padding: Theme.space-24;
        spacing: Theme.space-20;
        HorizontalLayout {
            Text {
                text: name;
                font-size: 20px;
                font-weight: 700;
                color: Theme.accent;
                font-family: Theme.font-mono;
                letter-spacing: 2px;
            }
            Rectangle { horizontal-stretch: 1; }
            HomeButton { clicked => { root.close(); } }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg-panel;
            VerticalLayout {
                alignment: center;
                spacing: Theme.space-8;
                Text {
                    text: "NOT YET COMMISSIONED";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Surface will come online after core stabilises";
                    font-size: 12px;
                    color: Theme.text-faint;
                    font-family: Theme.font-sans;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

component HomeButton inherits Rectangle {
    callback clicked;
    width: 96px;
    height: 30px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-panel;
    Text {
        width: 100%; height: 100%;
        text: "ESC  HOME";
        font-size: 10px;
        font-weight: 600;
        color: Theme.text-muted;
        font-family: Theme.font-mono;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

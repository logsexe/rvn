// RVN Design System — Operator Instrument
// Dark, precise, high-signal. Built for a lid-open cyberdeck.

export global Theme {
    // Backgrounds — near-black with cool undertone
    out property <color> bg-void: #06080c;
    out property <color> bg-base: #0c1017;
    out property <color> bg-panel: #111821;
    out property <color> bg-elevated: #18212c;
    out property <color> bg-hover: #1c2836;

    // Borders
    out property <color> border: #1c2836;
    out property <color> border-strong: #2a3a4d;
    out property <color> border-accent: #2dd4bf;

    // Accent — electric teal
    out property <color> accent: #2dd4bf;
    out property <color> accent-dim: #14b8a6;
    out property <color> accent-muted: #2dd4bf33;
    out property <color> accent-glow: #2dd4bf55;

    // Semantic
    out property <color> warn: #fbbf24;
    out property <color> danger: #f87171;
    out property <color> success: #4ade80;
    out property <color> info: #38bdf8;

    // Text
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #64748b;
    out property <color> text-faint: #475569;

    // Status mapping
    out property <color> status-ok: #4ade80;
    out property <color> status-warn: #fbbf24;
    out property <color> status-error: #f87171;
    out property <color> status-offline: #334155;
    out property <color> status-active: #2dd4bf;

    // Type
    out property <string> font-mono: "Share Tech Mono";
    out property <string> font-sans: "Inter";

    // Space scale
    out property <length> space-2: 2px;
    out property <length> space-4: 4px;
    out property <length> space-8: 8px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;
    out property <length> space-32: 32px;

    // Radius
    out property <length> radius-sm: 3px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;
}

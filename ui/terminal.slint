import { Theme } from "theme.slint";

// TERMINAL — operator command prompt

component HomeButton inherits Rectangle {
    callback clicked;

    width: 96px;
    height: 30px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-panel;

    Text {
        width: 100%; height: 100%;
        text: "Esc  home";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        font-family: Theme.font-sans;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
export component TerminalSurface inherits Rectangle {
    in-out property <string> output: "";
    in-out property <string> input: "";
    in property <string> cwd: "~";
    in property <bool> busy: false;

    callback close;
    callback submit(string);
    callback clear-output();

    background: Theme.bg-void;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Theme.space-12;
        spacing: Theme.space-8;

        HorizontalLayout {
            spacing: Theme.space-12;
            alignment: center;

            Text {
                text: "TERMINAL";
                font-size: 22px;
                font-weight: 600;
                color: Theme.text-primary;
                font-family: Theme.font-sans;
            }

            Text {
                text: "// SHELL";
                font-size: 12px;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: busy ? "RUNNING…" : "READY";
                font-size: 10px;
                font-weight: 700;
                color: busy ? Theme.warn : Theme.text-faint;
                font-family: Theme.font-mono;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 64px;
                height: 28px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.bg-panel;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "CLEAR";
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.clear-output(); }
                    mouse-cursor: pointer;
                }
            }

            HomeButton { clicked => { root.close(); } }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            background: #04060a;
            clip: true;

            // One console. The prompt is the next line of text, and the view
            // follows it only after the scrollback is taller than the screen.
            scroll := Flickable {
                width: 100%;
                height: 100%;
                content-width: self.width;
                property <length> body: prompt-label.y + prompt-label.height + 12px;
                content-height: max(self.height, body);
                content-y: -max(0px, body - self.height);

                output-text := Text {
                    x: 12px;
                    y: 12px;
                    width: scroll.width - 24px;
                    text: output == "" ? "RVN terminal ready.\nType help for commands.\n" : output;
                    font-size: 14px;
                    font-family: Theme.font-mono;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                prompt-label := Text {
                    x: 12px;
                    y: output-text.y + output-text.height;
                    text: cwd + " › ";
                    font-size: 14px;
                    color: Theme.accent;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }

                input-field := TextInput {
                    x: prompt-label.x + prompt-label.width;
                    y: prompt-label.y;
                    width: max(0px, scroll.width - self.x - 12px);
                    height: prompt-label.height;
                    text <=> root.input;
                    font-size: 14px;
                    font-family: Theme.font-mono;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    single-line: true;
                    enabled: !busy;

                    accepted => {
                        if (root.input != "") {
                            root.submit(root.input);
                        }
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close();
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }

    // The shell's key handler keeps focus until this field takes it.
    forward-focus: input-field;

    public function focus-prompt() {
        input-field.focus();
    }

    init => {
        input-field.focus();
    }
}


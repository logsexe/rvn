// RVN Design System — quiet instrument, one accent, real type.

export global Theme {
    // Backgrounds — layered, not flat black
    out property <color> bg-void: #080a0e;
    out property <color> bg-base: #10151c;
    out property <color> bg-panel: #161d27;
    out property <color> bg-elevated: #1c2532;
    out property <color> bg-hover: #222c3b;

    // Borders
    out property <color> border: #243041;
    out property <color> border-strong: #334155;
    out property <color> border-accent: #5eead4;

    // Accent — teal, used as a hairline rather than a flood
    out property <color> accent: #5eead4;
    out property <color> accent-dim: #2dd4bf;
    out property <color> accent-muted: #5eead422;
    out property <color> accent-glow: #5eead428;

    // Semantic
    out property <color> warn: #fbbf24;
    out property <color> danger: #f87171;
    out property <color> success: #4ade80;
    out property <color> info: #38bdf8;

    // Text
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #64748b;
    out property <color> text-faint: #475569;

    // Status mapping
    out property <color> status-ok: #4ade80;
    out property <color> status-warn: #fbbf24;
    out property <color> status-error: #f87171;
    out property <color> status-offline: #334155;
    out property <color> status-active: #2dd4bf;

    // Type — bundled in ui/fonts
    out property <string> font-mono: "JetBrains Mono";
    out property <string> font-sans: "Inter";

    // Space scale
    out property <length> space-2: 2px;
    out property <length> space-4: 4px;
    out property <length> space-8: 8px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;
    out property <length> space-32: 32px;

    // Radius
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 18px;
}

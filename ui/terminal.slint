import { Theme } from "theme.slint";

// TERMINAL — operator command prompt

component HomeButton inherits Rectangle {
    callback clicked;

    width: 96px;
    height: 30px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-panel;

    Text {
        width: 100%; height: 100%;
        text: "ESC  HOME";
        font-size: 10px;
        font-weight: 600;
        color: Theme.text-muted;
        font-family: Theme.font-mono;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
export component TerminalSurface inherits Rectangle {
    in-out property <string> output: "";
    in-out property <string> input: "";
    in property <string> cwd: "~";
    in property <bool> busy: false;

    callback close;
    callback submit(string);
    callback clear-output();

    background: Theme.bg-void;

    VerticalLayout {
        padding: Theme.space-20;
        spacing: Theme.space-12;

        // Header
        HorizontalLayout {
            spacing: Theme.space-12;
            alignment: center;

            Text {
                text: "TERMINAL";
                font-size: 20px;
                font-weight: 700;
                color: Theme.accent;
                font-family: Theme.font-mono;
                letter-spacing: 2px;
            }

            Text {
                text: "// SHELL";
                font-size: 12px;
                color: Theme.text-faint;
                font-family: Theme.font-mono;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: busy ? "RUNNING…" : "READY";
                font-size: 10px;
                font-weight: 700;
                color: busy ? Theme.warn : Theme.text-faint;
                font-family: Theme.font-mono;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            HomeButton { clicked => { root.close(); } }
        }

        // Output viewport
        Rectangle {
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            background: #04060a;
            vertical-stretch: 1;

            Flickable {
                width: 100%;
                height: 100%;
                content-width: self.width;
                content-height: output-text.preferred-height + 24px;

                output-text := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: output == "" ? "RVN terminal ready.\nType help for commands.\n" : output;
                    font-size: 13px;
                    font-family: Theme.font-mono;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
            }
        }

        // Prompt row
        Rectangle {
            height: 44px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.bg-panel;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: cwd + " ›";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.accent;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }

                input-field := TextInput {
                    text <=> root.input;
                    font-size: 13px;
                    font-family: Theme.font-mono;
                    color: Theme.text-primary;
                    single-line: true;
                    horizontal-stretch: 1;
                    enabled: !busy;

                    accepted => {
                        if (root.input != "") {
                            root.submit(root.input);
                        }
                    }
                }

                // Clear button
                Rectangle {
                    width: 64px;
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg-base;

                    Text {
                        width: 100%; height: 100%;
                        text: "CLEAR";
                        font-size: 10px;
                        font-weight: 600;
                        color: Theme.text-muted;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.clear-output(); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }

        // Hint strip
        Text {
            text: "Enter submits · help lists commands · clear resets scrollback";
            font-size: 11px;
            color: Theme.text-faint;
            font-family: Theme.font-sans;
        }
    }

    // Focus input when surface opens
    forward-focus: input-field;
}

